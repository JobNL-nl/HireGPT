import os
import requests
import pandas as pd
from datetime import datetime

# ---------------------------
# CONFIGURATION & FILTERS
# ---------------------------
API_KEY = os.getenv("UWV_API_KEY", "YOUR_UWV_API_KEY_HERE")  # <-- replace or export env var
SBI_CODES = ["0113", "0163", "5229", "8292"]  # greenhouse, food-processing, warehousing, temp-agency support
QUERY_KEYWORDS = ["seizoenswerk", "orderpicker", "oogstmedewerker", "piekperiode"]
RESULT_LIMIT = 1000  # max rows to fetch per request

UWV_ENDPOINT = "https://opendata.werk.nl/api/v1/solliciteren/vacatures"
SNF_CSV_URL = (
    "https://www.normeringflexwonen.nl/register/files/DownloadRegisterFile?type=CSV"
)

# ---------------------------
# UWV OPEN-DATA DOWNLOAD
# ---------------------------

def fetch_uwv_vacancies():
    """Download vacancy records that match SBI codes or keywords."""
    headers = {"X-Api-Key": API_KEY}
    params = {
        "query": " OR ".join(QUERY_KEYWORDS),
        "sbi": ",".join(SBI_CODES),
        "size": RESULT_LIMIT,
    }
    print("Requesting UWV vacancies…")
    r = requests.get(UWV_ENDPOINT, headers=headers, params=params, timeout=60)
    r.raise_for_status()
    data = r.json()

    # Normalise JSON → DataFrame
    df = pd.json_normalize(data["_embedded"]["vacatures"], sep=".")
    df["scrape_date"] = datetime.today().date()
    return df


def save_uwv(df: pd.DataFrame):
    out = "uwv_vacancies.csv"
    df.to_csv(out, index=False)
    print(f"Saved {len(df):,} UWV rows → {out}")


# ---------------------------
# SNF REGISTER DOWNLOAD
# ---------------------------

def fetch_snf_locations():
    print("Downloading SNF register…")
    r = requests.get(SNF_CSV_URL, timeout=60)
    r.raise_for_status()
    csv_content = r.content.decode("utf-8-sig")
    df = pd.read_csv(pd.compat.StringIO(csv_content), sep=";")
    df["scrape_date"] = datetime.today().date()
    return df


def save_snf(df: pd.DataFrame):
    out = "snf_locations.csv"
    df.to_csv(out, index=False)
    print(f"Saved {len(df):,} SNF rows → {out}")


# ---------------------------
# MAIN EXECUTION
# ---------------------------
if __name__ == "__main__":
    uwv_df = fetch_uwv_vacancies()
    save_uwv(uwv_df)

    snf_df = fetch_snf_locations()
    save_snf(snf_df)

    print("✅ Data collection complete.")# UWV & SNF Vacancy Scraper

This notebook retrieves open vacancies from the UWV Open-Data API and the SNF (Stichting Normering Flexwonen) housing register so you can build a targeted prospect list of Dutch companies that currently employ or accommodate migrant workers.

**How to use:**
1. Edit the *FILTERS* section (SBI codes, keywords, provinces, etc.).
2. Run the notebook; it will output two CSV files:
   * `uwv_vacancies.csv` – filtered vacancies with company, job title, location.
   * `snf_locations.csv` – housing locations with corresponding registered employer/agency.
3. Combine both datasets in Excel/PowerBI or your CRM to prioritise outreach.

> The UWV API is openly accessible but requires an `X-Api-Key` header.  Register for free at https://opendata.werk.nl/ to obtain your key.

> The SNF register provides a publicly downloadable CSV.  No authentication needed.

